# --- TinyBCI build parameters: cmake -DTBCI_PARADIGM=P300 -DTBCI_N_CLASSES=6 ...
set(TBCI_PARADIGM "SSVEP" CACHE STRING "Paradigm: SSVEP, P300 or MI")
set_property(CACHE TBCI_PARADIGM PROPERTY STRINGS SSVEP P300 MI)

set(TBCI_SSVEP_FREQUENCIES "4.5;5.0;5.5;6.0;6.5;7.0" CACHE STRING "SSVEP stimulus frequencies in Hz, ;-separated")
set(TBCI_N_HARMONICS 3 CACHE STRING "SSVEP: CCA reference harmonics")
set(TBCI_N_CLASSES 6 CACHE STRING "P300/MI: number of classes (SSVEP: one per frequency)")
set(TBCI_WINDOW_LENGTH_MS "" CACHE STRING "Epoch length in ms (empty = paradigm default)")
set(TBCI_WINDOW_OVERLAP_MS "" CACHE STRING "Sliding-window overlap in ms (empty = paradigm default)")
set(TBCI_NOTCH_FREQ 50 CACHE STRING "Mains frequency in Hz")
set(TBCI_EPOCH_CAPACITY "" CACHE STRING "Epochs per queue (empty = platform default)")
set(TBCI_MODEL_PATH "models/erp.onnx" CACHE FILEPATH "Pretrained model (P300/MI)")

set(TBCI_PARADIGM_SSVEP_ID 1)
set(TBCI_PARADIGM_P300_ID 2)
set(TBCI_PARADIGM_MI_ID 3)
set(TBCI_FREQUENCIES_C "{ 0 }")
set(TBCI_N_CLASSES_EFFECTIVE ${TBCI_N_CLASSES})
set(TBCI_WITH_ONNX OFF)

if(TBCI_PARADIGM STREQUAL "SSVEP")
    set(TBCI_PARADIGM_ID ${TBCI_PARADIGM_SSVEP_ID})
    list(LENGTH TBCI_SSVEP_FREQUENCIES TBCI_N_CLASSES_EFFECTIVE)   # one class per frequency
    list(JOIN TBCI_SSVEP_FREQUENCIES ", " _joined)
    set(TBCI_FREQUENCIES_C "{ ${_joined} }")
    set(_window 2000)
    set(_overlap 1900)
elseif(TBCI_PARADIGM STREQUAL "P300")
    set(TBCI_PARADIGM_ID ${TBCI_PARADIGM_P300_ID})
    set(TBCI_WITH_ONNX ON)
    set(_window 800)
    set(_overlap 0)
elseif(TBCI_PARADIGM STREQUAL "MI")
    set(TBCI_PARADIGM_ID ${TBCI_PARADIGM_MI_ID})
    set(TBCI_WITH_ONNX ON)
    set(_window 2000)
    set(_overlap 1500)
else()
    message(FATAL_ERROR "TBCI_PARADIGM must be SSVEP, P300 or MI (got '${TBCI_PARADIGM}')")
endif()

if(TBCI_WINDOW_LENGTH_MS STREQUAL "")
    set(TBCI_WINDOW_LENGTH_MS_EFFECTIVE ${_window})
else()
    set(TBCI_WINDOW_LENGTH_MS_EFFECTIVE ${TBCI_WINDOW_LENGTH_MS})
endif()
if(TBCI_WINDOW_OVERLAP_MS STREQUAL "")
    set(TBCI_WINDOW_OVERLAP_MS_EFFECTIVE ${_overlap})
else()
    set(TBCI_WINDOW_OVERLAP_MS_EFFECTIVE ${TBCI_WINDOW_OVERLAP_MS})
endif()

if(TBCI_EPOCH_CAPACITY STREQUAL "")
    if(TBCI_PICO)
        set(TBCI_EPOCH_CAPACITY_EFFECTIVE 2)
    else()
        set(TBCI_EPOCH_CAPACITY_EFFECTIVE 8)
    endif()
else()
    set(TBCI_EPOCH_CAPACITY_EFFECTIVE ${TBCI_EPOCH_CAPACITY})
endif()

if(TBCI_PICO AND TBCI_WITH_ONNX)
    message(FATAL_ERROR "${TBCI_PARADIGM} needs a model backend; ONNX Runtime doesn't run on the Pico (see the MCU model backend)")
endif()

configure_file(${CMAKE_CURRENT_LIST_DIR}/../include/config/tbci_build_config.h.in
        ${CMAKE_BINARY_DIR}/generated/tbci_build_config.h @ONLY)
message(STATUS "TinyBCI: ${TBCI_PARADIGM}, ${TBCI_N_CLASSES_EFFECTIVE} classes, "
        "window ${TBCI_WINDOW_LENGTH_MS_EFFECTIVE} ms, overlap ${TBCI_WINDOW_OVERLAP_MS_EFFECTIVE} ms, "
        "epochs ${TBCI_EPOCH_CAPACITY_EFFECTIVE}, onnx ${TBCI_WITH_ONNX}")